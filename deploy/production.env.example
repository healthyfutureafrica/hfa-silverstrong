# Copy to .env in the project folder on the server and fill in every value marked REQUIRED.
# Never commit the real .env (it is in .gitignore).

# REQUIRED: the public address of the app (DNS A record pointing to this server)
APP_DOMAIN=app.healthyfutureafrica.org
PUBLIC_APP_URL=https://app.healthyfutureafrica.org
PUBLIC_LOGIN_URL=https://app.healthyfutureafrica.org

# Port of the app container on the server itself (Caddy publishes 80/443 to the internet)
HFA_PORT=8080

# REQUIRED: 64 hex characters. Generate once with:  openssl rand -hex 32
# Store a copy offline: without this exact key, encrypted records, photos and documents cannot be read.
# If you move an existing database to this server, use the SAME key as before.
FILE_ENCRYPTION_KEY=

# First administrator, created only if no account with this email exists yet (password: 16+ characters).
# After the first sign-in, turn on two-step sign-in and change the password in Account security.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Production safety (also enforced by deploy/docker-compose.prod.yml)
DEMO_ACCOUNTS=false
REQUIRE_ADMIN_MFA=true

# WhatsApp notifications (optional; leave disabled until the Meta account is approved)
WHATSAPP_ENABLED=false
META_GRAPH_VERSION=v24.0
META_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ACTIVITY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_LOGIN_URL_PARAMETER=false
WHATSAPP_DAILY_RECIPIENT_LIMIT=20
WHATSAPP_DAILY_TOTAL_LIMIT=1000
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

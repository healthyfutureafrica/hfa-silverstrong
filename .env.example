HFA_PORT=8080
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_LOGIN_URL=http://localhost:8080
WHATSAPP_ENABLED=false
META_GRAPH_VERSION=v24.0
META_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ACTIVITY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_LOGIN_URL_PARAMETER=false
WHATSAPP_DAILY_RECIPIENT_LIMIT=20
WHATSAPP_DAILY_TOTAL_LIMIT=1000
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FILE_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=true
# Email for the Super Admin's backup sign-in codes (when the phone is unavailable). Free with Gmail: turn on 2-Step
# Verification on the sending Google account, create an app password (myaccount.google.com/apppasswords) and use
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<that address>, SMTP_PASS=<the app password>,
# MAIL_FROM="HFA SilverStrong <that address>". Leave empty to offer only the authenticator app and recovery codes.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SLY AI help (Claude: triage reading, doctor scribe, plain-language explanations). Off by default. Turn on only after the data-protection authority approves
# sending de-identified symptom text outside Cameroon (Law No. 2024/017, Art. 32). The rules work without it.
AI_ENABLED=false
# Cost cap: AI requests per person per day (about USD 0.0005 each with Claude Haiku 5.5).
AI_DAILY_LIMIT=30
ANTHROPIC_API_KEY=
# MTN Mobile Money (Collections API) for consultation fees, plans, home visits and rescheduling. Leave empty until
# HFA has an MTN MoMo merchant account; until then nothing is charged and fees are shown as payable at the facility.
# Sandbox: MTN_TARGET_ENVIRONMENT=sandbox (currency EUR). Cameroon: MTN_TARGET_ENVIRONMENT=mtncameroon, MTN_CURRENCY=XAF,
# MTN_BASE_URL=https://proxy.momoapi.mtn.com. MTN_CALLBACK_SECRET: 32+ random characters (callbacks need the public HTTPS address).
MTN_BASE_URL=
MTN_COLLECTION_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox
MTN_CURRENCY=
MTN_CALLBACK_SECRET=
# Voice/video calls: a free public STUN server is used by default. Add a TURN relay for networks that block direct
# connections (e.g. self-hosted coturn). CALL_TIMEZONE_OFFSET: appointment times are Cameroon time (+01:00).
STUN_URLS=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

{
  "name": "hfa-silverstrong",
  "version": "1.0.0",
  "description": "Static healthcare portal website",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest --runInBand",
    "lint": "html-validate index.html",
    "ci": "npm run lint && npm test && npm run test:backend",
    "test:backend": "node --test backend/test/*.test.js",
    "backend": "node --env-file-if-exists=.env backend/server.js",
    "docker:build": "docker build -t hfa-silverstrong:latest ."
  },
  "devDependencies": {
    "html-validate": "^8.4.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  }
}

// Cloudflare Workers static demo. Only dist/ (built from the public files) is uploaded.
// Unknown paths must return 404 (not index.html) so the app detects there is no backend.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hfa-silverstrong",
  // Edge script: redirects http:// and workers.dev to https://www.healthyfutureafrica.org and adds security headers.
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Keep the workers.dev address on (listing custom domains would otherwise switch it off);
  // the edge script redirects it to the main domain so old links still work.
  "workers_dev": true,
  // Served on the organisation's domain (DNS managed in the same Cloudflare account).
  "routes": [
    { "pattern": "www.healthyfutureafrica.org", "custom_domain": true },
    { "pattern": "healthyfutureafrica.org", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build:static"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The edge script runs first so it can redirect and add headers to every response.
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}

// Cloudflare Workers public platform. Only dist/ (built from the public files) is uploaded.
// The Worker handles account API paths with an explicit unconfigured-backend response.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hfa-silverstrong",
  // Edge script: redirects http:// and workers.dev to https://www.healthyfutureafrica.org and adds security headers.
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // The public site is served on the custom domains below; no workers.dev subdomain is configured.
  "workers_dev": false,
  // Served on the organisation's domain (DNS managed in the same Cloudflare account).
  "routes": [
    { "pattern": "www.healthyfutureafrica.org", "custom_domain": true, "zone_name": "healthyfutureafrica.org" },
    { "pattern": "healthyfutureafrica.org", "custom_domain": true, "zone_name": "healthyfutureafrica.org" }
  ],
  "build": {
    "command": "npm run build:static"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The edge script runs first so it can redirect and add headers to every response.
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}

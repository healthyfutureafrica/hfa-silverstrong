{
  "name": "hfa-whatsapp-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Healthy Future Africa WhatsApp triage chatbot (Meta WhatsApp Business Cloud API)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand --coverage",
    "migrate": "node src/db/index.js --migrate"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "openai": "^4.104.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "coverageThreshold": {
      "global": { "lines": 80 }
    }
  }
}

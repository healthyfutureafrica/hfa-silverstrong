# HFA WhatsApp bot configuration. Copy to .env (never commit .env).
# In production on EC2, prefer AWS Systems Manager Parameter Store / Secrets Manager and export the
# values into the PM2 environment instead of keeping a .env file on disk.

# --- Meta WhatsApp Business Cloud API (Meta Business Manager > WhatsApp > API Setup) ---
# Numeric ID of the HFA business phone number (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent access token of a System User with the whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# Any long random string you choose; enter the same value as "Verify token" when configuring the webhook
WHATSAPP_VERIFY_TOKEN=
# App secret (App Dashboard > Settings > Basic); used to check the X-Hub-Signature-256 header
WHATSAPP_APP_SECRET=
# Optional: Graph API version (default v24.0)
WHATSAPP_GRAPH_API_VERSION=v24.0

# --- OpenAI (GPT-4o triage, from Phase 2) ---
OPENAI_API_KEY=

# --- Redis (AWS ElastiCache). Use rediss:// when in-transit encryption is enabled ---
REDIS_URL=rediss://your-elasticache-endpoint:6379

# --- PostgreSQL (HFA RDS). Add ?sslmode=require for RDS ---
DATABASE_URL=postgres://hfa_whatsapp_bot:password@your-rds-endpoint:5432/hfa?sslmode=require

# --- HFA microservices ---
HFA_API_BASE_URL=https://api.healthyfutureafrica.org
# Internal service-to-service key issued for the bot
HFA_API_KEY=

# --- Runtime ---
PORT=4009
NODE_ENV=production
# error | warn | info | debug
LOG_LEVEL=info
